# Environment variables untuk template WAVEBOX.
# Salin file ini menjadi .env.local lalu isi sesuai kebutuhan.

# Supabase (OPSIONAL) — biarkan kosong untuk menjalankan mode demo lokal
# (data contoh + akun demo localStorage).
# Project Supabase baru memakai publishable key (sb_publishable_...);
# ANON_KEY legacy tetap didukung sebagai fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publik situs (opsional, dipakai untuk metadataBase/SEO & redirect OAuth).
NEXT_PUBLIC_SITE_URL=
